NODE_ENV=development
PORT=5000

CORS_ORIGIN=http://localhost:3000,http://localhost:8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_tracker

JWT_ACCESS_SECRET=your_jwt_access_secret_key_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GROQ_API_KEY=gsk_your_groq_api_key_here

# Model availability varies per Groq account and models get retired, so check what
# your key can actually reach before changing these:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# A model that is not available fails the whole job with: model_not_found (404).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Minimum AI confidence in income-vs-expense before a transaction is filed
# automatically. Below this it is held as needs_review for a one-tap confirmation
# and excluded from dashboard totals until resolved. Lower = less reviewing,
# higher = fewer wrong directions.
AI_TYPE_CONFIDENCE_THRESHOLD=0.7

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

ENABLE_GROQ_VISION=true
ENABLE_TESSERACT_FALLBACK=true

# Auto-run migrations and seed on server startup (set to 'false' to skip)
AUTO_MIGRATE=true
AUTO_SEED=true
